rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    // Allows viewers/crew linked via ownerId to read the admin's documents
    function isLinkedToOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == resource.data.userId;
    }
    function canRead() {
      return isDocOwner() || isLinkedToOwner();
    }
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Doc carries the caller's uid in its ownerId field (crew-created docs)
    // Admin OR manager. Manager exists so operational write access can be granted
    // without handing over the admin role, which is what gates user access and
    // group management. Deliberately NOT used in the /users or /user_groups
    // blocks — that separation is the whole point of the role.
    function isTenantStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    function isFieldOwner() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
    // Caller is linked (via their profile's ownerId) to the doc's ownerId field
    function isLinkedViaOwnerField() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == resource.data.ownerId;
    }
    // Crew reading a doc from their OWN assigned outlet within their own business.
    // Deliberately narrower than isLinkedViaOwnerField: shift handovers need to see
    // the store's entries, but a crew member has no reason to read other outlets.
    // Both comparisons read the same profile doc, so this costs one get(), not two.
    function isCrewOfSameOutlet() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == resource.data.ownerId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet == resource.data.outletId;
    }

    // Users collection — own profile only; admins can read all (UserManagement)
    // The tenant this caller belongs to. Falls back to their own uid, because an
    // owner-admin's profile usually has NO ownerId field at all — App.tsx patches
    // it in memory and never writes it back. Reading .ownerId directly would be
    // null for the owner and lock them out of their own business.
    function callerTenant() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('ownerId', request.auth.uid);
    }

    function callerHasRole(role) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Managers with an empty assignedOutlet are HQ managers. A populated value
    // is a hard store boundary for every operational document carrying outletId.
    function managerCanAccessResourceOutlet() {
      return !callerHasRole('manager') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedOutlet', '') == '' ||
        resource.data.get('outletId', '') ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet;
    }

    function managerCanAccessIncomingOutlet() {
      return !callerHasRole('manager') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedOutlet', '') == '' ||
        request.resource.data.get('outletId', '') ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet;
    }

    // Crew/waste documents carry both the acting user's uid and the business
    // owner's uid. These helpers keep those identities separate and prevent a
    // caller from moving an existing record between businesses.
    function incomingOperationalRecordBelongsToCaller() {
      return isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.ownerId == callerTenant();
    }

    function operationalRecordBelongsToCallerTenant() {
      return isAuthenticated() && resource.data.ownerId == callerTenant();
    }

    function operationalIdentityUnchanged() {
      return request.resource.data.userId == resource.data.userId &&
        request.resource.data.ownerId == resource.data.ownerId;
    }

    function crewCreateIsForAssignedOutlet() {
      return callerHasRole('crew') &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet == request.resource.data.outletId;
    }

    function crewUpdateIsForAssignedOutlet() {
      return callerHasRole('crew') && isCrewOfSameOutlet() &&
        request.resource.data.outletId == resource.data.outletId;
    }

    function incomingOwnerDocumentBelongsToCallerTenant() {
      return isAuthenticated() && request.resource.data.userId == callerTenant();
    }

    function ownerDocumentBelongsToCallerTenant() {
      return isAuthenticated() && resource.data.userId == callerTenant();
    }

    function incomingOwnerFieldBelongsToCallerTenant() {
      return isAuthenticated() && request.resource.data.ownerId == callerTenant();
    }

    function ownerFieldBelongsToCallerTenant() {
      return isAuthenticated() && resource.data.ownerId == callerTenant();
    }

    function ownerIdentityUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    function incomingOwnerOrStaffDocument() {
      return isAuthenticated() && (
        request.resource.data.userId == callerTenant() ||
        request.resource.data.userId == request.auth.uid
      );
    }

    function ownerOrStaffDocument() {
      return isAuthenticated() && (
        resource.data.userId == callerTenant() ||
        resource.data.userId == request.auth.uid
      );
    }

    function ownerFieldIdentityUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.userId == resource.data.userId;
    }

    function crewCanReadOwnerOutletDocument() {
      return callerHasRole('crew') && ownerDocumentBelongsToCallerTenant() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet == resource.data.outletId;
    }

    function crewCanCreateOwnerOutletDocument() {
      return callerHasRole('crew') && incomingOwnerDocumentBelongsToCallerTenant() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet == request.resource.data.outletId;
    }

    function crewCanUpdateOwnerOutletDocument() {
      return callerHasRole('crew') && crewCanReadOwnerOutletDocument() &&
        ownerIdentityUnchanged() && request.resource.data.outletId == resource.data.outletId;
    }

    function crewSnapshotFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'userId', 'outletId', 'month', 'year',
        'crewTotalPurchase', 'crewTotalExpense',
        'crewPurchaseByCategory', 'crewExpenseByCategory', 'crewCogsBucketAgg',
        'crewQtyByCategory', 'crewQtyMetaByCategory',
        'crewPendingTotalPurchase', 'crewPendingTotalExpense',
        'crewPendingPurchaseByCategory', 'crewPendingExpenseByCategory',
        'crewPendingCogsBucketAgg', 'crewLastUpdated'
      ]);
    }

    function crewSnapshotCreateFieldsOnly() {
      return request.resource.data.keys().hasOnly([
        'userId', 'outletId', 'month', 'year',
        'crewTotalPurchase', 'crewTotalExpense',
        'crewPurchaseByCategory', 'crewExpenseByCategory', 'crewCogsBucketAgg',
        'crewQtyByCategory', 'crewQtyMetaByCategory',
        'crewPendingTotalPurchase', 'crewPendingTotalExpense',
        'crewPendingPurchaseByCategory', 'crewPendingExpenseByCategory',
        'crewPendingCogsBucketAgg', 'crewLastUpdated'
      ]);
    }

    // True when the caller owns the business rather than merely administering it:
    // their profile points at nobody, or at themselves.
    function isTenantOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        callerTenant() == request.auth.uid;
    }

    // Fields a user must never change on their own document.
    function privilegedUnchanged() {
      return request.resource.data.get('role', '')           == resource.data.get('role', '')
          && request.resource.data.get('ownerId', '')        == resource.data.get('ownerId', '')
          && request.resource.data.get('groupId', '')        == resource.data.get('groupId', '')
          && request.resource.data.get('assignedOutlet', '') == resource.data.get('assignedOutlet', '')
          && request.resource.data.get('uid', '')            == resource.data.get('uid', '')
          && request.resource.data.get('userId', '')         == resource.data.get('userId', '');
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // First sign-in self-provision. Pinned to viewer and unlinked, so signing in
      // cannot mint an admin or attach the account to someone else's business.
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.get('role', '') == 'viewer'
        && !('ownerId' in request.resource.data);

      // You may edit your own profile, but not your own privileges. Previously
      // this was an unvalidated `allow write` on your own document, so any signed
      // in user could set role:'admin' from the browser console. The client guard
      // in UserManagement is an alert() and never reached the server.
      allow update: if isAuthenticated() && request.auth.uid == userId && privilegedUnchanged();

      // Handing out roles is the OWNER's alone — not every admin's. A delegated
      // admin (e.g. a finance account) can do their job but cannot promote
      // themselves, demote the owner, or delete accounts.
      // The `ownerId == ''` case exists so a freshly self-signed-up account can be
      // adopted into the business. It must NOT extend to admins: an owner's own
      // profile usually has no ownerId either (App.tsx patches it in memory and
      // never writes it back), so without the role guard below, any account that
      // also lacks an ownerId — and therefore passes isTenantOwner() by default —
      // could demote the real owner.
      // isTenantOwner() is SELF-ASSERTED: a profile with no ownerId passes it,
      // and every self-provisioned account (Google sign-in, App.tsx) starts that
      // way. So this block must never let a caller reach their OWN document —
      // otherwise a fresh sign-in could write { role:'admin', ownerId:<owner> }
      // in one go and take over the tenant. Self edits go through the
      // privilegedUnchanged rule above and nowhere else.
      //
      // Compared against the PATH-bound `userId`, not resource.data.uid: on
      // create, `resource` is null (the document does not exist yet), so
      // reading resource.data.get(...) unconditionally threw and denied every
      // new-user creation with "Missing or insufficient permissions" — the
      // bug this comment is now warning against.
      allow create, update, delete: if isAdmin() && isTenantOwner()
        && userId != request.auth.uid
        && (
          // Creating a profile for someone else, inside my own tenant.
          (resource == null && request.resource.data.get('ownerId', '') == request.auth.uid) ||
          // Someone already in my tenant.
          resource.data.get('ownerId', '') == request.auth.uid ||
          // Claiming an unlinked, non-admin account INTO my tenant. The write
          // must set ownerId to me — it is an adoption, not a free edit.
          (resource.data.get('ownerId', '') == '' &&
           resource.data.get('role', '') != 'admin' &&
           request.resource.data.get('ownerId', '') == request.auth.uid)
        );
    }

    // One immutable audit row per sign-in session. Users can record only their
    // own identity and tenant; only tenant admins can inspect the history.
    match /login_activity/{activityId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == callerTenant()
        && request.resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
        && request.resource.data.role == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        && request.resource.data.get('assignedOutlet', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedOutlet', '')
        && request.resource.data.loggedInAt == request.time
        && request.resource.data.locationStatus in ['available', 'denied', 'unavailable', 'unsupported']
        && request.resource.data.keys().hasOnly([
          'userId', 'ownerId', 'email', 'role', 'assignedOutlet', 'loggedInAt',
          'latitude', 'longitude', 'accuracyMeters', 'locationStatus'
        ]);
      allow get, list: if isAdmin() && resource.data.ownerId == callerTenant();
      allow delete: if isAdmin() && resource.data.ownerId == callerTenant();
      allow update: if false;
    }

    // category_settings uses the admin's UID as the document ID (no userId field inside)
    match /category_settings/{ownerId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == ownerId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == ownerId)
      );
      allow write: if isTenantStaff() && callerTenant() == ownerId;
    }

    // Collection: online_order_details
    match /online_order_details/{orderDetailId} {
      allow read: if canRead();
      allow create: if isTenantStaff() && incomingOwnerOrStaffDocument();
      allow update: if isTenantStaff() && ownerOrStaffDocument() && ownerIdentityUnchanged();
      allow delete: if isTenantStaff() && ownerOrStaffDocument();
    }

    // Collection: online_customers
    match /online_customers/{customerId} {
      allow read: if canRead();
      allow create: if isTenantStaff() && incomingOwnerOrStaffDocument();
      allow update: if isTenantStaff() && ownerOrStaffDocument() && ownerIdentityUnchanged();
      allow delete: if isTenantStaff() && ownerOrStaffDocument();
    }

    // Viewers can inspect balances. Crew see only their assigned outlet and may
    // move balances, but cannot rename/reassign accounts or change metadata.
    match /bank_accounts/{accountId} {
      allow read: if (ownerDocumentBelongsToCallerTenant() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        crewCanReadOwnerOutletDocument();
      allow create: if isTenantStaff() && incomingOwnerDocumentBelongsToCallerTenant() && managerCanAccessIncomingOutlet();
      allow update: if (
        isTenantStaff() && ownerDocumentBelongsToCallerTenant() && ownerIdentityUnchanged() &&
        managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()
      ) || (
        crewCanUpdateOwnerOutletDocument() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt'])
      );
      allow delete: if isTenantStaff() && ownerDocumentBelongsToCallerTenant() && managerCanAccessResourceOutlet();
    }

    // daily_sales_logs — crew writes with their own userId; admin reads via ownerId
    match /daily_sales_logs/{docId} {
      // userId here is the CREW MEMBER who submitted, not the owner, so
      // isLinkedToOwner (caller.ownerId vs doc.userId) never matches for a
      // delegated admin. isLinkedViaOwnerField compares ownerId to ownerId.
      allow read: if (operationalRecordBelongsToCallerTenant() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        isCrewOfSameOutlet();
      allow create: if incomingOperationalRecordBelongsToCaller() &&
        ((isTenantStaff() && managerCanAccessIncomingOutlet()) || crewCreateIsForAssignedOutlet());
      allow update: if operationalIdentityUnchanged() && (
        (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()) ||
        crewUpdateIsForAssignedOutlet()
      );
      allow delete: if (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet()) ||
        (callerHasRole('crew') && isDocOwner() && isCrewOfSameOutlet());
    }

    // sales_ledger — same pattern as daily_sales_logs
    match /sales_ledger/{docId} {
      // userId here is the CREW MEMBER who submitted, not the owner, so
      // isLinkedToOwner (caller.ownerId vs doc.userId) never matches for a
      // delegated admin. isLinkedViaOwnerField compares ownerId to ownerId.
      allow read: if (operationalRecordBelongsToCallerTenant() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        isCrewOfSameOutlet();
      allow create: if incomingOperationalRecordBelongsToCaller() &&
        ((isTenantStaff() && managerCanAccessIncomingOutlet()) || crewCreateIsForAssignedOutlet());
      allow update: if operationalIdentityUnchanged() && (
        (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()) ||
        crewUpdateIsForAssignedOutlet()
      );
      allow delete: if (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet()) ||
        (callerHasRole('crew') && isDocOwner() && isCrewOfSameOutlet());
    }

    // bank_transactions — admin queries by userId; crew-written entries (10K transfer etc.)
    // store ownerId so the admin can also query by ownerId
    match /bank_transactions/{docId} {
      // userId here is the CREW MEMBER who submitted, not the owner, so
      // isLinkedToOwner (caller.ownerId vs doc.userId) never matches for a
      // delegated admin. isLinkedViaOwnerField compares ownerId to ownerId.
      allow read: if (operationalRecordBelongsToCallerTenant() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        isCrewOfSameOutlet();
      allow create: if incomingOperationalRecordBelongsToCaller() &&
        ((isTenantStaff() && managerCanAccessIncomingOutlet()) || crewCreateIsForAssignedOutlet());
      allow update: if operationalIdentityUnchanged() && (
        (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()) ||
        crewUpdateIsForAssignedOutlet()
      );
      allow delete: if (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet()) ||
        (callerHasRole('crew') && isDocOwner() && isCrewOfSameOutlet());
    }

    // vendors — owner's business only (docs always carry ownerId; query by it)
    match /vendors/{docId} {
      allow read: if canRead() || isFieldOwner() || isLinkedViaOwnerField();
      allow create: if (isTenantStaff() || callerHasRole('crew')) &&
        incomingOwnerFieldBelongsToCallerTenant() && request.resource.data.userId == request.auth.uid;
      // isLinkedViaOwnerField is on the read rule but was missing here, so a
      // manager or delegated admin could SEE a record created by a crew member
      // and not edit it: these docs carry the creator's uid in userId, which is
      // what isLinkedToOwner compares against. ownerId-to-ownerId is the test
      // that identifies someone else in the same business.
      allow update: if (isTenantStaff() || callerHasRole('crew')) &&
        ownerFieldBelongsToCallerTenant() && ownerFieldIdentityUnchanged();
      allow delete: if (isTenantStaff() || callerHasRole('crew')) && ownerFieldBelongsToCallerTenant();
    }

    // products — owner's business only (docs always carry ownerId; query by it)
    match /products/{docId} {
      allow read: if canRead() || isFieldOwner() || isLinkedViaOwnerField();
      allow create: if (isTenantStaff() || callerHasRole('crew')) &&
        incomingOwnerFieldBelongsToCallerTenant() && request.resource.data.userId == request.auth.uid;
      // isLinkedViaOwnerField is on the read rule but was missing here, so a
      // manager or delegated admin could SEE a record created by a crew member
      // and not edit it: these docs carry the creator's uid in userId, which is
      // what isLinkedToOwner compares against. ownerId-to-ownerId is the test
      // that identifies someone else in the same business.
      allow update: if (isTenantStaff() || callerHasRole('crew')) &&
        ownerFieldBelongsToCallerTenant() && ownerFieldIdentityUnchanged();
      allow delete: if (isTenantStaff() || callerHasRole('crew')) && ownerFieldBelongsToCallerTenant();
    }

    // fc_ingredients / fc_recipes — Recipe Costing module. Deliberately isolated
    // from the P&L collections: nothing outside this module reads or writes them.
    match /fc_ingredients/{docId} {
      allow read: if canRead() || isFieldOwner() || isLinkedViaOwnerField();
      allow create: if isTenantStaff() && incomingOwnerFieldBelongsToCallerTenant() &&
        request.resource.data.userId == request.auth.uid;
      // isLinkedViaOwnerField is on the read rule but was missing here, so a
      // manager or delegated admin could SEE a record created by a crew member
      // and not edit it: these docs carry the creator's uid in userId, which is
      // what isLinkedToOwner compares against. ownerId-to-ownerId is the test
      // that identifies someone else in the same business.
      allow update: if isTenantStaff() && ownerFieldBelongsToCallerTenant() && ownerFieldIdentityUnchanged();
      allow delete: if isTenantStaff() && ownerFieldBelongsToCallerTenant();
    }

    match /fc_recipes/{docId} {
      allow read: if canRead() || isFieldOwner() || isLinkedViaOwnerField();
      allow create: if isTenantStaff() && incomingOwnerFieldBelongsToCallerTenant() &&
        request.resource.data.userId == request.auth.uid;
      // isLinkedViaOwnerField is on the read rule but was missing here, so a
      // manager or delegated admin could SEE a record created by a crew member
      // and not edit it: these docs carry the creator's uid in userId, which is
      // what isLinkedToOwner compares against. ownerId-to-ownerId is the test
      // that identifies someone else in the same business.
      allow update: if isTenantStaff() && ownerFieldBelongsToCallerTenant() && ownerFieldIdentityUnchanged();
      allow delete: if isTenantStaff() && ownerFieldBelongsToCallerTenant();
    }

    // inventory_items is the shared count-list configuration. Store-scoped
    // managers can count their outlet but cannot change the common item list.
    match /inventory_items/{docId} {
      allow read: if canRead() || isFieldOwner() || isLinkedViaOwnerField();
      allow create: if isTenantStaff() && incomingOwnerFieldBelongsToCallerTenant() &&
        (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedOutlet', '') == '');
      allow update: if isTenantStaff() && ownerFieldBelongsToCallerTenant() && ownerIdentityUnchanged() &&
        (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedOutlet', '') == '');
      allow delete: if isTenantStaff() && ownerFieldBelongsToCallerTenant() &&
        (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedOutlet', '') == '');
    }

    // menu_prices — the stated menu list price, one doc per master item name.
    // These docs carry userId = the BUSINESS OWNER's uid, not the editor's, so a
    // delegated admin's edit lands on the same doc the page reads back. The
    // catch-all rule below would reject exactly that (it requires the incoming
    // userId to equal the caller's uid), hence the explicit block: an admin may
    // write on behalf of the owner they are linked to, and nobody else may.
    match /menu_prices/{docId} {
      allow read: if canRead();
      allow create: if isTenantStaff() && incomingOwnerDocumentBelongsToCallerTenant();
      allow update: if isTenantStaff() && ownerDocumentBelongsToCallerTenant() && ownerIdentityUnchanged();
      allow delete: if isTenantStaff() && ownerDocumentBelongsToCallerTenant();
    }

    // crew_categories — custom terminal categories; admin-only writes, crew read-only.
    // The ownerId check alone already stops crew creating a category anyone sees:
    // their profile's ownerId is the admin's uid, so the doc they'd write can
    // never carry their own. isAdmin() is added so the rule states the intent
    // outright rather than relying on that indirection, and so the collection
    // can't accumulate self-owned orphan docs that no dropdown ever reads.
    match /crew_categories/{docId} {
      allow read: if canRead() || isFieldOwner() || isLinkedViaOwnerField();
      allow create: if isTenantStaff() && incomingOwnerFieldBelongsToCallerTenant();
      allow update: if isTenantStaff() && ownerFieldBelongsToCallerTenant() &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isTenantStaff() && ownerFieldBelongsToCallerTenant();
    }

    // crew_entries — crew writes with their own userId + admin's ownerId; admin queries by ownerId.
    // Crew also read their assigned outlet's entries (not just their own) so a shift
    // can see what the previous shift recorded and avoid duplicate entries.
    match /crew_entries/{docId} {
      // isLinkedViaOwnerField matters for anyone in the tenant who is not the
      // owner and not crew — a delegated (e.g. finance) admin. These documents
      // carry the CREW MEMBER's uid in userId, so isLinkedToOwner, which compares
      // the caller's ownerId against userId, never matches. Without this clause
      // Find Matching Bill returned nothing for them: the crew leg was denied and
      // fell back to an empty list.
      allow read: if (operationalRecordBelongsToCallerTenant() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        isCrewOfSameOutlet();
      allow create: if incomingOperationalRecordBelongsToCaller() &&
        ((isTenantStaff() && managerCanAccessIncomingOutlet()) || crewCreateIsForAssignedOutlet());
      // isCrewOfSameOutlet() added so one crew member can settle a bill a
      // teammate on a different shift logged — Settle Pending Bills bulk-marks
      // paid across a whole month, which routinely spans more than one author.
      // Already true for read (shift handover); update needed the same reach.
      allow update: if operationalIdentityUnchanged() && (
        (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()) ||
        crewUpdateIsForAssignedOutlet()
      );
      // Preserve the existing delete boundary: staff can delete inside their
      // tenant; crew can delete only records they authored in their own outlet.
      allow delete: if (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet()) ||
        (callerHasRole('crew') && isDocOwner() && isCrewOfSameOutlet());
    }

    // waste_entries — crew writes; admin reads/deletes via ownerId
    match /waste_entries/{docId} {
      // Same gap as crew_entries: userId is the recording crew member's, so a
      // delegated admin needs the ownerId-to-ownerId comparison.
      allow read: if (operationalRecordBelongsToCallerTenant() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        isCrewOfSameOutlet();
      allow create: if incomingOperationalRecordBelongsToCaller() &&
        ((isTenantStaff() && managerCanAccessIncomingOutlet()) || crewCreateIsForAssignedOutlet());
      allow update: if operationalIdentityUnchanged() && (
        (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()) ||
        crewUpdateIsForAssignedOutlet()
      );
      allow delete: if (isTenantStaff() && operationalRecordBelongsToCallerTenant() && managerCanAccessResourceOutlet()) ||
        (callerHasRole('crew') && isDocOwner() && isCrewOfSameOutlet());
    }

    // expense_snapshots — admin owns; linked crew can write (they generate entries that feed reporting)
    match /expense_snapshots/{snapId} {
      allow read: if (ownerOrStaffDocument() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        crewCanReadOwnerOutletDocument();
      allow create: if (isTenantStaff() && incomingOwnerOrStaffDocument() && managerCanAccessIncomingOutlet()) || (
        crewCanCreateOwnerOutletDocument() && crewSnapshotCreateFieldsOnly()
      );
      allow update: if (
        isTenantStaff() && ownerOrStaffDocument() && ownerIdentityUnchanged() &&
        managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()
      ) || (
        crewCanUpdateOwnerOutletDocument() && crewSnapshotFieldsOnly()
      );
      allow delete: if isTenantStaff() && ownerOrStaffDocument() && managerCanAccessResourceOutlet();
    }

    // bill_counters — per-outlet-per-day bill number sequence; doc carries the
    // admin's UID in userId so both the admin and linked crew can bump it
    match /bill_counters/{counterId} {
      allow read: if resource == null ||
        (ownerDocumentBelongsToCallerTenant() && !callerHasRole('crew') && managerCanAccessResourceOutlet()) ||
        (callerHasRole('crew') && ownerDocumentBelongsToCallerTenant() && (
          !('outletId' in resource.data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet == resource.data.outletId
        ));
      allow create: if (isTenantStaff() && incomingOwnerDocumentBelongsToCallerTenant() && managerCanAccessIncomingOutlet()) ||
        crewCanCreateOwnerOutletDocument();
      allow update: if (
        isTenantStaff() && ownerDocumentBelongsToCallerTenant() && ownerIdentityUnchanged() &&
        managerCanAccessResourceOutlet() && managerCanAccessIncomingOutlet()
      ) || (
        callerHasRole('crew') && ownerDocumentBelongsToCallerTenant() && ownerIdentityUnchanged() &&
        request.resource.data.get('ownerId', '') == callerTenant() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedOutlet == request.resource.data.outletId &&
        resource.data.get('outletId', request.resource.data.outletId) == request.resource.data.outletId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'outletId', 'seq', 'updatedAt'])
      );
      allow delete: if isTenantStaff() && ownerDocumentBelongsToCallerTenant() && managerCanAccessResourceOutlet();
    }

    // cash_flow_snapshots — admin-only; keyed by ownerId_year_month
    match /cash_flow_snapshots/{snapId} {
      allow read: if resource == null || ownerDocumentBelongsToCallerTenant();
      allow create: if isTenantStaff() && incomingOwnerDocumentBelongsToCallerTenant();
      allow update: if isTenantStaff() && ownerDocumentBelongsToCallerTenant() && ownerIdentityUnchanged();
      allow delete: if isTenantStaff() && ownerDocumentBelongsToCallerTenant();
    }

    // loan_profiles — owner and linked users only
    match /loan_profiles/{profileId} {
      allow read: if canRead();
      allow create: if isTenantStaff() && incomingOwnerDocumentBelongsToCallerTenant();
      allow update: if isTenantStaff() && ownerDocumentBelongsToCallerTenant() && ownerIdentityUnchanged();
      allow delete: if isTenantStaff() && ownerDocumentBelongsToCallerTenant();
    }

    // ---------------------------------------------------------------------
    // Bank reconciliation working set.
    //
    // These three used to fall to the catch-all, whose write clause requires the
    // document's userId to equal the caller's own uid — i.e. only the business
    // owner could ever write them. That made "give the finance person the admin
    // role" not work: they could match bills (crew_entries has its own rule that
    // accepts isAdmin) but every categorisation of a bank line was denied.
    //
    // Writes are admins inside this tenant, plus the owner. Reads stay as the
    // catch-all had them, so nobody loses visibility.
    // ---------------------------------------------------------------------
    match /bank_statement_imports/{docId} {
      allow read: if resource == null || canRead();
      allow write: if isDocOwner() || (isTenantStaff() && isLinkedToOwner()) ||
        (resource == null && isTenantStaff() && isAuthenticated() &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownerId', request.auth.uid) == request.resource.data.userId);
    }

    match /categorization_rules/{docId} {
      allow read: if resource == null || canRead();
      allow write: if isDocOwner() || (isTenantStaff() && isLinkedToOwner()) ||
        (resource == null && isTenantStaff() && isAuthenticated() &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownerId', request.auth.uid) == request.resource.data.userId);
    }

    match /purchases/{docId} {
      allow read: if resource == null || (canRead() && managerCanAccessResourceOutlet());
      allow write: if (isDocOwner() && managerCanAccessResourceOutlet() &&
          (request.resource == null || managerCanAccessIncomingOutlet())) ||
        (isTenantStaff() && isLinkedToOwner() && managerCanAccessResourceOutlet() &&
          (request.resource == null || managerCanAccessIncomingOutlet())) ||
        (resource == null && isTenantStaff() && isAuthenticated() &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownerId', request.auth.uid) == request.resource.data.userId &&
         managerCanAccessIncomingOutlet());
    }

    // user_groups — which modules appear in a member's sidebar.
    //
    // PRESENTATION ONLY. No rule in this file reads moduleIds, and none is gated
    // on group membership. A member of any group can still read every collection
    // their ownerId link already permits; hiding a nav entry hides the link, not
    // the data. Do not cite this block as an access control.
    //
    // The generic match explicitly excludes this collection. Matching rules
    // are additive: their order does not give this block priority.
    match /user_groups/{groupId} {
      // Every member of the tenant reads: a viewer has to fetch its own group to
      // know what to render. resource == null mirrors bill_counters, so a getDoc
      // on a deleted group returns empty instead of erroring.
      allow read: if isAuthenticated() && (
        resource == null || isFieldOwner() || isLinkedViaOwnerField()
      );
      // Only admins write, and only inside their own tenant.
      allow create: if isAdmin() && isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId == request.resource.data.ownerId
      ) && request.resource.data.userId == request.resource.data.ownerId;
      allow update: if isAdmin() && (isFieldOwner() || isLinkedViaOwnerField())
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.userId == resource.data.ownerId;
      allow delete: if isAdmin() && (isFieldOwner() || isLinkedViaOwnerField());
    }

    // Default rule for all other collections
    match /{collection}/{docId} {
      // All matching allow clauses are ORed, including more specific matches.
      // Keep collections with stricter identity/tenant rules out of the generic
      // fallback; matching allow clauses are additive, not ordered overrides.
      function isGenericCollection() {
        return !(collection in [
          'users', 'user_groups', 'category_settings', 'online_order_details',
          'online_customers', 'bank_accounts', 'daily_sales_logs', 'sales_ledger',
          'bank_transactions', 'vendors', 'products', 'fc_ingredients', 'fc_recipes',
          'inventory_items',
          'menu_prices', 'crew_categories', 'crew_entries', 'waste_entries',
          'expense_snapshots', 'bill_counters', 'cash_flow_snapshots', 'loan_profiles',
          'bank_statement_imports', 'categorization_rules', 'purchases', 'login_activity'
        ]);
      }
      function isOutletScopedCollection() {
        return collection in [
          'sales_snapshots', 'item_snapshots', 'pnl_snapshots', 'cogs_adjustments',
          'monthly_payrolls', 'employees', 'rentals', 'files', 'sales_summary',
          'sales_analytics', 'item_sales', 'expenses', 'events', 'inventory_counts'
        ];
      }
      function genericManagerReadAllowed() {
        return !isOutletScopedCollection() || managerCanAccessResourceOutlet();
      }
      function genericManagerWriteAllowed() {
        return !isOutletScopedCollection() ||
          ((resource == null || managerCanAccessResourceOutlet()) &&
           (request.resource == null || managerCanAccessIncomingOutlet()));
      }
      // resource == null allows getDoc() on a not-yet-existing doc (no data to leak);
      // without it, canRead() dereferences resource.data.userId on null and denies.
      allow read: if isGenericCollection() && (resource == null || (canRead() && genericManagerReadAllowed()));
      // Two ways in.
      //
      // 1. The document is literally yours — the original rule, unchanged. This
      //    is how the business owner writes everything.
      //
      // 2. You are an admin or manager acting inside your own tenant, on a
      //    document belonging to the business owner. Without this branch a
      //    delegated admin could not write ANY of these collections, because
      //    ownership was the only test — which is why granting someone the admin
      //    role did not actually let them edit anything here.
      //
      // Only the explicit rules above authorize user/profile group access.
      allow write: if isGenericCollection() && isTenantStaff() && genericManagerWriteAllowed() && (
        (
          (resource == null || resource.data.get('userId', '') == request.auth.uid) &&
          (request.resource == null || request.resource.data.get('userId', '') == request.auth.uid)
        ) || (
          (resource == null || resource.data.get('userId', '') == callerTenant()) &&
          (request.resource == null || request.resource.data.get('userId', '') == callerTenant())
        )
      );
    }
  }
}
